{
  "permissions": {
    "allow": [
      "Bash(Select-Object Name, FullName)",
      "Bash(grep -E \"\\\\.sln$|\\\\.props$|\\\\.ps1$\")",
      "Bash(grep \"\\\\.sln$\")",
      "mcp__azure-devops__repo_get_pull_request_by_id",
      "mcp__azure-devops__repo_get_pull_request_changes"
    ]
  },
